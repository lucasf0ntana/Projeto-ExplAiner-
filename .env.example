# Necessário para assinar sessões Flask em produção. Use uma chave longa e aleatória.
FLASK_SECRET_KEY=troque-por-uma-chave-aleatoria-e-segura

# Opcional: quando configurada, os desafios são gerados pela API da OpenAI.
# Sem esta chave, o sistema usa o banco local de questões demonstrativas.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Deixe 0 em desenvolvimento local. Em produção HTTPS, use 1.
COOKIE_SECURE=0
FLASK_DEBUG=False
